# Rousto API — production example (copy to .env)
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@db:5432/rousto
CORS_ORIGINS=https://rousto.com,https://www.rousto.com
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_API_KEY=change-me-to-a-strong-admin-key
OTP_DEV_MODE=false
ALLOW_LEGACY_HEADERS=false
DISABLE_OPENAPI=true
RATE_LIMIT_PER_MINUTE=5
SENTRY_DSN=
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=
